{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Silas-Asamoah/stormlog/docs/schemas/stormlog_run_envelope_v1.schema.json",
  "title": "Stormlog Run Envelope v1",
  "description": "Local-first top-level investigation envelope for Stormlog sessions and attachments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "run_id", "metadata"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "format": {
      "type": "string",
      "const": "stormlog.run_envelope"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "job_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "started_at_ns": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "ended_at_ns": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "created_at_utc": {
      "type": ["string", "null"]
    },
    "updated_at_utc": {
      "type": ["string", "null"]
    },
    "source_namespace": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "source_ref": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session_ref"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment_ref"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "session_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "metadata"],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "rank": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "local_rank": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "world_size": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "role": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_namespace": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "attachment_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "kind", "storage", "metadata"],
      "anyOf": [
        {"required": ["url"]},
        {"required": ["path"]}
      ],
      "properties": {
        "attachment_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "enum": ["reference", "copy"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "session_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "job_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "rank": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "local_rank": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "world_size": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "start_ns": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "end_ns": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "created_at_utc": {
          "type": ["string", "null"]
        },
        "updated_at_utc": {
          "type": ["string", "null"]
        },
        "source_namespace": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_ref": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
